<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:gravity="center|left"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_menu"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/baseline_menu_24"
                android:contentDescription="Menu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Local AI Chat: "
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/StatysModel"
                android:layout_width="wrap_content"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="Нет модели"
                android:textColor="@color/red"
                android:layout_height="wrap_content"/>

            <ImageView
                android:id="@+id/New_Chat_Ai"
                android:layout_marginRight="10dp"
                android:layout_width="25dp"
                android:src="@drawable/baseline_chat_24"
                android:layout_height="25dp"/>

            <ImageView
                android:id="@+id/modelSetting"
                android:src="@drawable/baseline_create_24"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:contentDescription="Model Settings" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:background="@color/white"
            android:layout_height="2dp"/>

        <ListView
            android:id="@+id/ListView"
            android:drawSelectorOnTop="false"
            android:cacheColorHint="@android:color/transparent"
            android:dividerHeight="0dp"
            android:paddingTop="10dp"
            android:clipToPadding="false"
            android:paddingBottom="10dp"
            android:transcriptMode="alwaysScroll"
            android:scrollbars="none"
            android:listSelector="@android:color/transparent"
            android:divider="@null"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/round_top"
            android:layout_height="wrap_content">

            <View
                android:layout_width="wrap_content"
                android:layout_height="15dp"/>

            <EditText
                android:id="@+id/editText"
                android:layout_width="match_parent"
                android:maxLines="5"
                android:hint="Задайте вопрос..."
                android:textColorHint="@color/white"
                android:textStyle="bold"
                android:paddingLeft="15dp"
                android:textColor="@color/white"
                android:paddingRight="15dp"
                android:textSize="15sp"
                android:background="@android:color/transparent"
                android:minHeight="48dp"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_marginRight="15dp"
                android:layout_marginLeft="15dp"
                android:orientation="horizontal"
                android:layout_marginBottom="15dp"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="0dp"/>

                <ImageView
                    android:id="@+id/Start_micro"
                    android:layout_width="30dp"
                    android:src="@drawable/baseline_mic_24"
                    android:layout_height="30dp"
                    android:contentDescription="Mic" />

                <ImageView
                    android:id="@+id/send"
                    android:layout_width="30dp"
                    android:layout_marginLeft="15dp"
                    android:src="@drawable/baseline_send_24"
                    android:layout_height="30dp"
                    android:contentDescription="Send" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/drawer_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/drawer_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/three_gradient"
        android:translationX="-1000dp"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.70">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_menu_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ваши чаты:"
                android:layout_gravity="left"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:background="@color/white"
                android:layout_height="2dp"/>

            <ListView
                android:id="@+id/chatHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawSelectorOnTop="false"
                android:cacheColorHint="@android:color/transparent"
                android:dividerHeight="0dp"
                android:scrollbars="none"
                android:paddingTop="10dp"
                android:clipToPadding="false"
                android:listSelector="@android:color/transparent"
                android:divider="@null"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/drawer_right_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/three_gradient"
        android:translationX="1000dp"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.70">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_right_menu_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:text="Настройки модели:"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/white" />

            <ScrollView
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:gravity="center|top"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/LoadAilModel"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        android:text="Загрузить модель"
                        android:textStyle="bold"
                        android:layout_gravity="left"
                        android:paddingLeft="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:paddingRight="10dp"
                        android:textSize="15sp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/round2"
                        android:textColor="@color/white"
                        android:layout_marginEnd="10dp"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/EndLoadAilModel"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Выгрузить модель"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"
                        android:paddingLeft="10dp"
                        android:layout_gravity="left"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:paddingRight="10dp"
                        android:textSize="15sp"
                        android:visibility="gone"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/round2"
                        android:textColor="@color/white"
                        android:layout_marginEnd="10dp"
                        android:layout_height="wrap_content"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:layout_height="wrap_content">

                        <ProgressBar
                            android:id="@+id/load_model_bar"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="0dp"
                            android:visibility="gone"
                            android:layout_weight="1"
                            android:layout_marginBottom="5dp"
                            android:layout_height="wrap_content"
                            android:indeterminate="true" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/white" />

                    <TextView
                        android:layout_width="match_parent"
                        android:text="Количество токенов:"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"
                        android:textSize="15sp"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="10dp"
                        android:textColor="@color/white"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:id="@+id/maxToken"
                        android:layout_width="match_parent"
                        android:maxLines="1"
                        android:inputType="number"
                        android:hint="Макс. токенов: "
                        android:textColorHint="@color/white"
                        android:textStyle="bold"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="10dp"
                        android:paddingLeft="15dp"
                        android:layout_marginBottom="5dp"
                        android:textColor="@color/white"
                        android:paddingRight="15dp"
                        android:textSize="15sp"
                        android:background="@drawable/round2"
                        android:minHeight="48dp"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:textColor="@color/white"
                        android:textStyle="italic"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginBottom="10dp"
                        android:textSize="12sp"
                        android:text="⚠️ Длина ответа в токенах, низкие значения могут обрезать текст ответа!"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:background="@color/white"
                        android:layout_marginBottom="10dp"
                        android:layout_height="2dp"/>

                    <EditText
                        android:id="@+id/SystemPromtAi"
                        android:layout_width="match_parent"
                        android:maxLines="3"
                        android:hint="Промт для нейросети: "
                        android:textColorHint="@color/white"
                        android:textStyle="bold"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="10dp"
                        android:paddingLeft="15dp"
                        android:layout_marginBottom="5dp"
                        android:textColor="@color/white"
                        android:paddingRight="15dp"
                        android:textSize="15sp"
                        android:background="@drawable/round2"
                        android:minHeight="48dp"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:textColor="@color/white"
                        android:textStyle="italic"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginBottom="10dp"
                        android:textSize="12sp"
                        android:text="! — Системный промпт для ии например: Отвечай только на русском языке!"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:background="@color/white"
                        android:layout_marginBottom="10dp"
                        android:layout_height="2dp"/>
                    
                    <CheckBox
                        android:id="@+id/SelectChatMemory"
                        android:layout_width="match_parent"
                        android:buttonTint="@null"
                        app:buttonTint="@null"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:paddingStart="10dp"
                        android:paddingLeft="10dp"
                        android:textColor="@color/white"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="10dp"
                        android:text="Включить память в чате"
                        android:button="@drawable/custom_checkbox_selector"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:textColor="@color/white"
                        android:textStyle="italic"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginBottom="10dp"
                        android:textSize="12sp"
                        android:text="❗ — При отключении каждый запрос будет обрабатываться отдельно, без контекста!"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:background="@color/white"
                        android:layout_marginBottom="10dp"
                        android:layout_height="2dp"/>

                    <TextView
                        android:id="@+id/Battery_optimization"
                        android:layout_width="match_parent"
                        android:text="Отпимизация батареи: "
                        android:layout_marginBottom="10dp"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="10dp"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:background="@color/white"
                        android:layout_marginBottom="10dp"
                        android:layout_height="2dp"/>

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/img_btn_niz"
        android:background="@drawable/round2_cc"
        android:layout_width="50dp"
        android:visibility="gone"
        android:layout_marginBottom="120dp"
        android:layout_height="50dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/baseline_keyboard_double_arrow_down_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
